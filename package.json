{
  "name": "nuts-and-bolts",
  "version": "0.2.13",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "release": "commit-and-tag-version",
    "build:release": "npm run release && vite build",
    "preview": "vite preview",
    "test": "vitest --run",
    "coverage": "vitest --run --coverage",
    "coverage:report": "vitest --run --coverage --reporter=default && node scripts/open-coverage.cjs",
    "test:e2e": "playwright test",
    "check:accessibility": "node scripts/check_palettes.cjs",
    "test:watch": "vitest --watch",
    "simulate": "node scripts/run-sim.js",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint src --ext .ts,.tsx,.js,.jsx --fix"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "commit-and-tag-version": "^13.2.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "commit-and-tag-version": {
      "dotgitignore": {
        "minimatch": "^10.2.6"
      }
    }
  },
  "vitest": {
    "environment": "jsdom",
    "include": [
      "tests/**/*.test.*",
      "tests/**/*.spec.*"
    ],
    "exclude": [
      "e2e/**"
    ],
    "coverage": {
      "exclude": [
        "src/assets/icons/**"
      ]
    }
  }
}
